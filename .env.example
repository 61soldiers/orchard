# Required. ./setup.sh fills this in for you on first run.
# To set it yourself: any string of 24+ characters. Clients send it as
# `Authorization: Bearer <key>`. Treat it like a password.
ORCHARD_API_KEY=

# Optional.
# ORCHARD_ADDR=:8080
# ORCHARD_DATA_DIR=/data
# ORCHARD_LOG_LEVEL=info
# ORCHARD_TRUST_PROXY_HEADERS=false
# ORCHARD_SHUTDOWN_TIMEOUT=15s

# Wrapper provisioning. Defaults fetch the release matching the host
# architecture from GitHub and verify it against the published digest.
# ORCHARD_WRAPPER_AUTO_PROVISION=true
# ORCHARD_WRAPPER_TAG=wrapper.x86_64.latest
# ORCHARD_WRAPPER_URL=
# ORCHARD_WRAPPER_SHA256=

# Wrapper daemon. Keep the host on loopback: these ports are unauthenticated.
# ORCHARD_WRAPPER_HOST=127.0.0.1
# ORCHARD_WRAPPER_DECRYPT_PORT=10020
# ORCHARD_WRAPPER_M3U8_PORT=20020
# ORCHARD_WRAPPER_ACCOUNT_PORT=30020
# ORCHARD_WRAPPER_KEY_PORT=40020
# ORCHARD_WRAPPER_DEVICE_INFO=
# ORCHARD_WRAPPER_PROXY=
